{
  "name": "cel-benchmark-poster",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "bundle": "node scripts/bundle-artifact.mjs",
    "render": "node scripts/render.mjs",
    "audit:claims": "node scripts/audit-claims.mjs",
    "audit:layout": "node scripts/audit-layout.mjs",
    "audit:pdf": "node scripts/audit-pdf.mjs",
    "audit:offline": "node scripts/audit-offline.mjs",
    "package": "node scripts/package-deliverables.mjs",
    "audit:package": "node scripts/audit-package.mjs",
    "plots:generate": "uv run --project ../.. --no-sync python ../plots/plot_ce_examples.py --transparent && uv run --project ../.. --no-sync python ../plots/manuscript_typography.py",
    "plots:test": "uv run --project ../.. --no-sync pytest -q ../plots",
    "verify:all": "pnpm run plots:generate && pnpm run plots:test && node ../research/scripts/validate-claims.mjs && node ../research/scripts/validate-brief.mjs && pnpm run typecheck && pnpm test && pnpm run build && pnpm run bundle && pnpm run audit:offline && pnpm run render && pnpm run audit:layout && pnpm run audit:claims && pnpm run audit:pdf && pnpm run package && pnpm run audit:package"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.35.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-resizable-panels": "^2.1.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@parcel/config-default": "^2.16.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "html-inline": "^1.2.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.79.0",
    "parcel": "^2.16.4",
    "parcel-resolver-tspaths": "^0.0.9",
    "playwright": "1.55.0",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  }
}
